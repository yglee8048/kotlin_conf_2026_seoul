<?xml version="1.0" encoding="UTF-8"?>
<!--
  발표용 로그 포맷.

  한 줄에서 확인할 수 있어야 하는 것이 네 가지다.

    22:41:03.512 INFO  P[open-banking-1     ] [trace=none    ] OpenBankingAdapter : ...
                       ^ ^                    ^
                       | |                    |
                       | |                    +- MDC 전파 여부 (3·7단계)
                       | +- 어느 풀에서 도는가 (2단계 이후 계속)
                       +- 플랫폼(P) 인가 가상(V) 스레드인가 (8단계 이후)

  application.yaml 의 logging.pattern.console 대신 여기에 둔 이유는
  커스텀 conversionRule 이 필요하기 때문이다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <conversionRule conversionWord="vt" class="com.example.demo.logging.ThreadKindConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %vt[%-20.20t] [trace=%-8.8X{traceId:-none}] %-22.22logger{0} : %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
